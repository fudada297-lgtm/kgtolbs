---
import BaseLayout from '../layouts/BaseLayout.astro';
const examples = [
  { kg: 50, lbs: (50 * 2.20462262185).toFixed(2) },
  { kg: 62.5, lbs: (62.5 * 2.20462262185).toFixed(2) },
  { kg: 75, lbs: (75 * 2.20462262185).toFixed(2) },
  { kg: 100, lbs: (100 * 2.20462262185).toFixed(2) },
];
---

<BaseLayout title="How to Convert KG to LBS — Complete Guide" description="Learn how to convert kg to lbs. Formula, worked examples, and a free converter." canonical="https://kgtolbs.cc/how-to-convert-kg-to-lbs">
  <section class="hero">
    <div class="wrap">
      <h1 style="font-size:2.2rem;font-weight:800;color:#1a202c;margin-bottom:0.3rem;">How to Convert KG to LBS</h1>
      <p style="font-size:1.1rem;color:var(--text-light);">Step-by-step guide with formula and examples</p>
    </div>
  </section>
  <div class="wrap" style="padding-top:1.5rem;">
    <div class="sc">
      <h2>The Formula</h2>
      <div class="formula">Pounds (lbs) = Kilograms (kg) × 2.20462262185</div>
      <p>Quick mental math: <strong>lbs &asymp; kg × 2.2</strong></p>
      <p>The pound is legally defined as <strong>0.45359237 kg</strong>. Therefore 1 kg = 1 / 0.45359237 = 2.20462262185 lbs.</p>
    </div>
    <div class="sc">
      <h2>Worked Examples</h2>
      {examples.map(ex => (
        <div class="formula">{ex.kg} kg × 2.2046 = <strong>{ex.lbs} lbs</strong></div>
      ))}
    </div>
    <div class="sc">
      <h2>When You Need This Conversion</h2>
      <ul>
        <li><strong>Fitness:</strong> Body weight in kg to lbs</li>
        <li><strong>Cooking:</strong> International recipes</li>
        <li><strong>Shipping:</strong> Package weight limits</li>
        <li><strong>Healthcare:</strong> Patient weight, dosing</li>
      </ul>
      <div class="links-row"><a href="/">Back to Converter</a> &middot; <a href="/conversion-table">View Table</a></div>
    </div>
  </div>
</BaseLayout>
