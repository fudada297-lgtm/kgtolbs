---
import BaseLayout from '../layouts/BaseLayout.astro';
const kg = 1; const lbs = (kg * 2.20462262185).toFixed(4);
---

<BaseLayout title={`${kg} KG to LBS — ${kg} kg = ${lbs} lbs`} description={`${kg} kilogram equals ${lbs} pounds. Free converter with detailed calculation.`} canonical="https://kgtolbs.cc/1-kg-to-lbs">
  <section class="hero">
    <div class="wrap">
      <h1 style="font-size:2.2rem;font-weight:800;color:#1a202c;margin-bottom:0.3rem;">{kg} KG to LBS</h1>
      <p style="font-size:1.1rem;color:var(--text-light);">{kg} kilogram = <strong>{lbs}</strong> pounds</p>
    </div>
  </section>
  <div class="wrap" style="padding-top:1.5rem;">
    <div class="sc">
      <h2>{kg} Kilogram to Pounds Breakdown</h2>
      <div class="formula">{kg} kg × 2.20462262185 = <strong>{lbs} lbs</strong></div>
      <p>1 kilogram is exactly 2.20462262185 pounds. Multiply {kg} by this factor to get {lbs} pounds.</p>
      <p style="margin-top:0.5rem;">Rounded: <strong>{kg} kg &asymp; {parseFloat(lbs).toFixed(2)} lbs</strong></p>
      <div class="links-row"><a href="/">Home</a> &middot; <a href="/5-kg-to-lbs">5 kg to lbs</a> &middot; <a href="/10-kg-to-lbs">10 kg to lbs</a></div>
    </div>
  </div>
</BaseLayout>
