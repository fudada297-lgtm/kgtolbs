---
import BaseLayout from '../layouts/BaseLayout.astro';
import Converter from '../components/Converter.astro';

const kg = 1;
const lbs = (kg * 2.20462262185).toFixed(4);
const title = `1 KG to LBS - Convert ${kg} Kilogram to Pounds`;
const description = `Convert ${kg} kg to lbs instantly. ${kg} kilogram equals ${lbs} pounds. Free online converter with detailed explanation.`;
---

<BaseLayout title={title} description={description} canonical="https://kgtolbs.cc/1-kg-to-lbs">
  <script type="application/ld+json" set:html={`{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "1 KG to LBS Converter",
    "url": "https://kgtolbs.cc/1-kg-to-lbs",
    "description": "${description}"
  }`} />

  <div class="container">
    <Converter initialKg={String(kg)} initialLbs={lbs} />

    <div class="content-section">
      <h2>{kg} Kilogram to Pounds Conversion</h2>
      <p><strong>{kg} kilogram (kg)</strong> is equal to exactly <strong>{lbs} pounds (lbs)</strong>.</p>

      <div class="formula">
        {kg} kg × 2.20462262185 = <strong>{lbs} lbs</strong>
      </div>

      <h3>Conversion Breakdown</h3>
      <ul>
        <li>1 kilogram = 2.20462262185 pounds</li>
        <li>{kg} × 2.20462262185 = {lbs} pounds</li>
        <li>Rounded to 2 decimal places: <strong>{kg} kg = {parseFloat(lbs).toFixed(2)} lbs</strong></li>
      </ul>

      <p style="margin-top: 1.5rem;">
        <a href="/">Back to KG to LBS Converter</a> &middot;
        <a href="/5-kg-to-lbs">5 kg to lbs</a> &middot;
        <a href="/10-kg-to-lbs">10 kg to lbs</a>
      </p>
    </div>
  </div>
</BaseLayout>
