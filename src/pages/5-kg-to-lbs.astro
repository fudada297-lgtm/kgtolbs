---
import BaseLayout from '../layouts/BaseLayout.astro';
import Converter from '../components/Converter.astro';

const kg = 5;
const lbs = (kg * 2.20462262185).toFixed(4);
const title = `5 KG to LBS - Convert ${kg} Kilograms to Pounds`;
const description = `Convert ${kg} kg to lbs instantly. ${kg} kilograms equals ${lbs} pounds. Free online converter with real-world examples.`;
---

<BaseLayout title={title} description={description} canonical="https://kgtolbs.cc/5-kg-to-lbs">
  <script type="application/ld+json" set:html={`{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "5 KG to LBS Converter",
    "url": "https://kgtolbs.cc/5-kg-to-lbs"
  }`} />

  <div class="hero">
    <h1>{kg} KG to LBS</h1>
    <p>{kg} kilograms = {lbs} pounds</p>
  </div>

  <Converter initialKg={String(kg)} initialLbs={lbs} />

  <div class="card">
    <h2>{kg} Kilograms to Pounds — Complete Breakdown</h2>
    <p><strong>{kg} kilograms (kg)</strong> equals exactly <strong>{lbs} pounds (lbs)</strong>.</p>

    <div class="formula-box">
      {kg} kg × 2.20462262185 = <strong>{lbs} lbs</strong>
    </div>

    <h3>Real-World Reference</h3>
    <p>A typical house cat or a large bag of flour weighs about <strong>{kg} kg ({lbs} lbs)</strong>. In fitness, a {kg} kg dumbbell is a common starting weight for beginners.</p>

    <div class="inline-links">
      <a href="/">Home</a> &middot;
      <a href="/1-kg-to-lbs">1 kg to lbs</a> &middot;
      <a href="/10-kg-to-lbs">10 kg to lbs</a>
    </div>
  </div>
</BaseLayout>
