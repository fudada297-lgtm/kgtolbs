---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="KG to LBS Conversion Table — 1 to 100 Chart" description="Complete kilograms to pounds conversion chart from 1 to 100 kg. Free reference table." canonical="https://kgtolbs.cc/conversion-table">
  <section class="hero">
    <div class="wrap">
      <h1 style="font-size:2.2rem;font-weight:800;color:#1a202c;margin-bottom:0.3rem;">KG to LBS Conversion Table</h1>
      <p style="font-size:1.1rem;color:var(--text-light);">1–100 kilograms to pounds quick reference</p>
    </div>
  </section>
  <div class="wrap" style="padding-top:1.5rem;">
    <div class="sc">
      <div class="sticky-table">
        <table>
          <thead><tr><th>Kilograms (kg)</th><th>Pounds (lbs)</th></tr></thead>
          <tbody>
            {Array.from({length: 100}, (_, i) => i + 1).map(kg => (
              <tr><td><strong>{kg} kg</strong></td><td>{(kg * 2.20462262185).toFixed(4)} lbs</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="margin-top:1rem;">Need a custom value? Use the <a href="/" style="color:var(--teal);">interactive converter</a>.</p>
    </div>
  </div>
</BaseLayout>
