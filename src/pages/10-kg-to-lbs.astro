---
import BaseLayout from '../layouts/BaseLayout.astro';
const kg = 10; const lbs = (kg * 2.20462262185).toFixed(4);
---

<BaseLayout title={`${kg} KG to LBS — ${kg} kg = ${lbs} lbs`} description={`${kg} kilograms equals ${lbs} pounds. Free converter with real-world examples.`} canonical={`https://kgtolbs.cc/${kg}-kg-to-lbs`}>
  <section class="bg-white border-b border-gray-100">
    <div class="max-w-5xl mx-auto px-4 py-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-2">{kg} KG to LBS</h1>
      <p class="text-lg text-gray-500">{kg} kilograms = <strong class="text-gray-800">{lbs}</strong> pounds</p>
    </div>
  </section>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">{kg} Kilograms to Pounds — Full Breakdown</h2>
      <div class="bg-brand-50 border border-brand-100 rounded-lg px-4 py-3 text-center font-semibold text-brand-800 mb-4">
        {kg} kg × 2.20462262185 = <strong>{lbs} lbs</strong>
      </div>
      <p class="text-gray-600"><strong>{kg} kg</strong> is roughly the weight of a gym dumbbell or a medium suitcase. Most airlines set carry-on limits at {kg} kg.</p>
      <div class="flex gap-4 mt-6 text-sm font-medium">
        <a href="/" class="text-brand-500 hover:underline">Home</a>
        <a href="/1-kg-to-lbs" class="text-brand-500 hover:underline">1 kg to lbs</a>
        <a href="/5-kg-to-lbs" class="text-brand-500 hover:underline">5 kg to lbs</a>
      </div>
    </div>
  </div>
</BaseLayout>
