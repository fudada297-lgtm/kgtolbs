---
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
---

<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <SEO title={title} description={description} canonical={canonical} />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      color: #1e293b;
      line-height: 1.6;
    }

    /* Header */
    header {
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(255,255,255,0.2);
      padding: 1rem 0;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .container { max-width: 860px; margin: 0 auto; padding: 0 1.25rem; }
    header .container { display: flex; align-items: center; justify-content: space-between; }
    header .logo {
      font-size: 1.3rem;
      font-weight: 800;
      background: linear-gradient(135deg, #667eea, #764ba2);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-decoration: none;
    }
    header nav { display: flex; gap: 1.25rem; }
    header nav a {
      color: #64748b;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: color 0.2s;
    }
    header nav a:hover { color: #667eea; }

    /* Hero */
    .hero {
      text-align: center;
      padding: 3rem 0 2rem;
      color: white;
    }
    .hero h1 {
      font-size: 2.5rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
      text-shadow: 0 2px 10px rgba(0,0,0,0.15);
    }
    .hero p {
      font-size: 1.15rem;
      opacity: 0.9;
      max-width: 500px;
      margin: 0 auto;
    }
    @media (max-width: 600px) {
      .hero h1 { font-size: 1.75rem; }
      .hero p { font-size: 1rem; }
    }

    /* Cards */
    .card {
      background: white;
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.1), 0 1px 4px rgba(0,0,0,0.06);
      padding: 2rem;
      margin: 0 auto 1.5rem;
      transition: transform 0.2s, box-shadow 0.2s;
      max-width: 860px;
      margin-left: auto;
      margin-right: auto;
    }
    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.08);
    }

    /* Converter */
    .converter-grid {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 2rem;
    }
    @media (max-width: 640px) {
      .converter-grid { grid-template-columns: 1fr; gap: 1rem; }
    }
    .input-group { position: relative; }
    .input-group label {
      display: block;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: #475569;
      font-size: 0.95rem;
    }
    .input-group input {
      width: 100%;
      padding: 0.9rem 1rem;
      font-size: 1.3rem;
      border: 2px solid #e2e8f0;
      border-radius: 12px;
      outline: none;
      transition: all 0.2s;
      background: #f8fafc;
    }
    .input-group input:focus {
      border-color: #667eea;
      box-shadow: 0 0 0 4px rgba(102,126,234,0.12);
      background: white;
    }
    .input-system {
      font-size: 0.82rem;
      color: #94a3b8;
      margin-top: 0.4rem;
    }
    .equals-symbol {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      background: linear-gradient(135deg, #667eea, #764ba2);
      border-radius: 50%;
      color: white;
      font-size: 1.5rem;
      font-weight: bold;
      flex-shrink: 0;
    }
    @media (max-width: 640px) {
      .equals-symbol { width: 40px; height: 40px; font-size: 1.25rem; margin: 0 auto; }
    }

    /* Content */
    .card h2 { font-size: 1.4rem; margin-bottom: 1rem; color: #1e293b; }
    .card h3 { font-size: 1.1rem; margin: 1.25rem 0 0.5rem; color: #334155; }
    .card p, .card li { margin-bottom: 0.7rem; color: #475569; }
    .card ul, .card ol { padding-left: 1.5rem; margin-bottom: 1rem; }

    .formula-box {
      background: linear-gradient(135deg, #f0f4ff 0%, #faf5ff 100%);
      border-left: 4px solid #667eea;
      padding: 1rem 1.5rem;
      border-radius: 0 12px 12px 0;
      font-size: 1.15rem;
      font-weight: 500;
      margin: 1rem 0;
    }

    /* Table */
    table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.92rem; }
    thead th {
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: white;
      padding: 0.75rem 1rem;
      font-weight: 600;
    }
    thead th:first-child { border-radius: 10px 0 0 0; }
    thead th:last-child { border-radius: 0 10px 0 0; }
    tbody td { padding: 0.55rem 1rem; border-bottom: 1px solid #f1f5f9; text-align: center; }
    tbody tr:hover { background: #f8fafc; }
    tbody tr:nth-child(even) { background: #fafafa; }
    tbody tr:nth-child(even):hover { background: #f1f5f9; }

    /* FAQ */
    .faq-item { margin-bottom: 1.25rem; padding-bottom: 1.25rem; border-bottom: 1px solid #f1f5f9; }
    .faq-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .faq-item h3 { margin-top: 0; color: #667eea; }

    /* Ad placeholder */
    .ad-spot {
      background: #f8fafc;
      border: 2px dashed #e2e8f0;
      border-radius: 12px;
      padding: 2rem;
      text-align: center;
      color: #94a3b8;
      font-size: 0.85rem;
      max-width: 860px;
      margin: 0 auto 1.5rem;
    }

    .highlight { background: linear-gradient(180deg, transparent 60%, #fef08a 60%); padding: 0 2px; }

    /* Footer */
    footer {
      text-align: center;
      padding: 2.5rem 0;
      color: rgba(255,255,255,0.7);
      font-size: 0.9rem;
    }
    footer a { color: white; text-decoration: none; font-weight: 500; }
    footer a:hover { text-decoration: underline; }

    /* Links */
    .inline-links { text-align: center; margin-top: 1.5rem; }
    .inline-links a {
      color: #667eea;
      text-decoration: none;
      font-weight: 500;
      margin: 0 0.5rem;
    }
    .inline-links a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <a href="/" class="logo">KGtoLBS.cc</a>
      <nav>
        <a href="/">Converter</a>
        <a href="/conversion-table">Table</a>
        <a href="/how-to-convert-kg-to-lbs">How To</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer>
    <p>&copy; 2026 <a href="/">KG to LBS Converter</a> &mdash; Free Online Tool</p>
  </footer>
</body>
</html>
