---
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
---

<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="cB6nM9Q9dNsQaj5ThyGvflKxZB0u_td0Ye2vhpqL3qM" />
  <SEO title={title} description={description} canonical={canonical} />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: { 50: '#e6fffa', 100: '#b2f5ea', 200: '#81e6d9', 300: '#4fd1c5', 400: '#38b2ac', 500: '#319795', 600: '#2c7a7b', 700: '#285e61', 800: '#234e52', 900: '#1d4044' }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-gray-50 min-h-screen antialiased">
  <header class="bg-white border-b border-gray-200 sticky top-0 z-20">
    <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
      <a href="/" class="text-lg font-bold text-gray-800">KG<span class="text-brand-500">to</span>LBS<span class="text-brand-500">.cc</span></a>
      <nav class="flex gap-4 sm:gap-6 text-sm font-medium text-gray-500">
        <a href="/" class="hover:text-brand-500 transition-colors">Converter</a>
        <a href="/conversion-table" class="hover:text-brand-500 transition-colors">Table</a>
        <a href="/how-to-convert-kg-to-lbs" class="hover:text-brand-500 transition-colors">How To</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="border-t border-gray-200 mt-12">
    <div class="max-w-5xl mx-auto px-4 py-8 text-center text-sm text-gray-400">
      <p>&copy; 2026 <a href="/" class="text-brand-500 hover:underline">KG to LBS Converter</a> &mdash; Free Online Weight Conversion Tools</p>
    </div>
  </footer>
</body>
</html>
