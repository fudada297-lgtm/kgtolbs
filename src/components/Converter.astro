---
const { initialKg = '', initialLbs = '' } = Astro.props;

const kgValue = String(initialKg);
const lbsValue = String(initialLbs);
---

<div class="converter-card">
  <div class="input-row">
    <div>
      <label for="kg-input">Kilograms</label>
      <input type="number" id="kg-input" placeholder="0" value={kgValue} min="0" step="any">
      <div class="unit">kg</div>
    </div>
    <button class="swap-btn" id="swap-btn" title="Swap units">⇄</button>
    <div>
      <label for="lbs-input">Pounds</label>
      <input type="number" id="lbs-input" placeholder="0" value={lbsValue} min="0" step="any">
      <div class="unit">lbs</div>
    </div>
  </div>

  <div class="conversion-rate">
    1 kg = 2.20462262185 lbs
  </div>

  <button class="copy-btn" id="copy-btn">
    COPY RESULT <span>( or press arrow key )</span>
  </button>
</div>

<script>
  const kgInput = document.getElementById('kg-input') as HTMLInputElement;
  const lbsInput = document.getElementById('lbs-input') as HTMLInputElement;
  const swapBtn = document.getElementById('swap-btn') as HTMLButtonElement;
  const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;

  function updateLbs() {
    const kg = parseFloat(kgInput.value);
    if (isNaN(kg)) { lbsInput.value = ''; return; }
    lbsInput.value = (kg * 2.20462262185).toFixed(5);
  }

  function updateKg() {
    const lbs = parseFloat(lbsInput.value);
    if (isNaN(lbs)) { kgInput.value = ''; return; }
    kgInput.value = (lbs / 2.20462262185).toFixed(5);
  }

  kgInput.addEventListener('input', updateLbs);
  lbsInput.addEventListener('input', updateKg);

  swapBtn.addEventListener('click', () => {
    const temp = kgInput.value;
    kgInput.value = lbsInput.value;
    lbsInput.value = temp;
  });

  copyBtn.addEventListener('click', () => {
    const val = lbsInput.value || kgInput.value;
    if (val) {
      navigator.clipboard.writeText(val);
      copyBtn.textContent = 'COPIED!';
      setTimeout(() => { copyBtn.innerHTML = 'COPY RESULT <span>( or press arrow key )</span>'; }, 1500);
    }
  });
</script>
