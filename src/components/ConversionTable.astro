---
import { kgToLbs, formatNumber } from '../utils/conversions';

interface Props {
  start?: number;
  end?: number;
  step?: number;
  title?: string;
  showAll?: boolean;
}

const { start = 1, end = 50, step = 1, title = 'KG to LBS Conversion Table', showAll = false } = Astro.props;

const rows: { kg: number; lbs: string }[] = [];
for (let kg = start; kg <= end; kg += step) {
  rows.push({ kg, lbs: formatNumber(kgToLbs(kg), 4) });
}
const lbsRows: { lbs: number; kg: string }[] = [];
if (!showAll) {
  // Add some common LBS values too
  const commonLbs = [1, 5, 10, 20, 50, 100, 200];
  for (const lbs of commonLbs) {
    lbsRows.push({ lbs, kg: formatNumber(lbs / 2.20462262185, 4) });
  }
}
---

<div class="content-section" id="table">
  <h2>{title}</h2>
  <p>Quick reference for common kilograms to pounds conversions:</p>

  <table class="conversion-table">
    <thead>
      <tr>
        <th>Kilograms (kg)</th>
        <th>Pounds (lbs)</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr>
          <td><strong>{row.kg} kg</strong></td>
          <td>{row.lbs} lbs</td>
        </tr>
      ))}
    </tbody>
  </table>

  {!showAll && (
    <>
      <p style="margin-top: 1.5rem;">Also common reverse conversions:</p>
      <table class="conversion-table">
        <thead>
          <tr>
            <th>Pounds (lbs)</th>
            <th>Kilograms (kg)</th>
          </tr>
        </thead>
        <tbody>
          {lbsRows.map(row => (
            <tr>
              <td><strong>{row.lbs} lbs</strong></td>
              <td>{row.kg} kg</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}
</div>
